{
  "name": "api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "bun run index.ts",
    "check-and-start": "bun run typecheck && bun run start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:delete": "bun run src/db/delete.ts",
    "db:seed": "bun run src/db/seed.ts",
    "test": "DATABASE_URL=credential-vault.test.sqlite bun run db:migrate && DATABASE_URL=credential-vault.test.sqlite bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
