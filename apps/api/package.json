{
  "name": "api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "bun run index.ts",
    "check-and-start": "bun run typecheck && bun run start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:delete": "bun run src/db/delete.ts",
    "db:rebuild": "bun run src/db/rebuild.ts && bun run db:migrate",
    "db:seed": "bun run src/db/seed.ts",
    "crypto:generate-key": "bun run src/crypto/generate-key.ts",
    "test": "DATABASE_URL=postgres://credential_vault:credential_vault_dev_password@localhost:5432/credential_vault_test bun run db:rebuild && DATABASE_URL=postgres://credential_vault:credential_vault_dev_password@localhost:5432/credential_vault_test bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "libsodium-wrappers": "^0.8.4",
    "postgres": "^3.4.9"
  }
}
